{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schema/brain-0.1.schema.json",
  "title": "Adversary brain, schema version 0.1",
  "description": "Normative schema for one brain document (publish form). Anything not listed here is rejected: LOCAL fields (fidelity, weight, observability, first_seen, last_seen) and attribution are deliberately absent. Canonical forms (ADR 011): ids are lowercase UUIDv4; created/modified are full-date ISO 8601 strings and MUST be quoted in YAML source so they parse as strings, not date objects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "title", "status", "scale", "representation",
    "match", "tlp", "created", "modified", "entities", "links"
  ],
  "properties": {
    "schema": { "const": "brain/0.1" },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "UUIDv4, stable for the brain's life"
    },
    "title": { "type": "string", "maxLength": 256 },
    "status": { "enum": ["experimental", "test", "stable", "retired"] },
    "scale": { "enum": ["link", "technique-set", "attack-chain", "campaign", "threat-actor"] },
    "representation": { "enum": ["graph", "list", "chain", "centroid", "embedding"] },
    "match": { "enum": ["exact", "distance", "similarity", "sequence", "likelihood"] },
    "threshold": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.7 },
    "tlp": { "enum": ["clear", "green", "amber", "amber-strict", "red"] },
    "author": { "type": "string" },
    "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "modified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "references": {
      "type": "array",
      "items": { "type": "string", "pattern": "^https?://\\S+$" }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "type": { "enum": ["derived", "obsoletes", "merged", "split-from"] }
        }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/entity" }
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/link" }
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "oneOf": [
        { "required": ["value"], "not": { "required": ["pattern"] } },
        { "required": ["pattern"], "not": { "required": ["value"] } }
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "type": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "pattern": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_.:-]+(\\|(equals|contains|starts|ends|not-contains))?$"
          },
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "source", "target", "relation", "role", "volatility", "provenance"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "type": { "enum": ["state", "activity"] },
        "source": { "type": "string" },
        "target": { "type": "string" },
        "relation": { "type": "string", "minLength": 1 },
        "role": { "enum": ["required", "supporting"] },
        "volatility": { "enum": ["stable", "rotating", "ephemeral"] },
        "prior": { "type": "number", "minimum": 0, "maximum": 1 },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source"],
          "properties": {
            "kind": { "enum": ["observed", "derived", "reported"] },
            "source": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
